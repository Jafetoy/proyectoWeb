# Copy this file to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=<GENERATE_A_RANDOM_SECRET>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
MYSQL_DATABASE=canaco_db
MYSQL_USER=canaco_app
MYSQL_PASSWORD=<GENERATE_A_RANDOM_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_A_DIFFERENT_RANDOM_PASSWORD>
DB_HOST=127.0.0.1
DB_PORT=3306
